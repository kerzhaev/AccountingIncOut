<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui" onLoad="RibbonCallbacks.RibbonOnLoad">
  <ribbon>
    <tabs>
      <tab id="tabUchetVhIsh" label="Учет Вх./Исх." insertAfterMso="TabData">
        
        <group id="grpProcessing" label="Обработка">
          <button id="btnMassProcess" 
                  label="Периодическая сверка" 
                  imageMso="DatabaseUpdate"
                  size="large" 
                  onAction="RibbonCallbacks.btnMassProcess_Click"
                  screentip="Периодический запуск сопоставления"
                  supertip="Единый запуск: пакетный matching, Legacy Match Review и Legacy Package Backfill по одной выгрузке 1С"/>
          
          <separator id="sep1"/>
          
          <button id="btnMatchDoverennosti" 
                  label="Сопоставить доверенности" 
                  imageMso="FindDialog"
                  size="large" 
                  onAction="RibbonCallbacks.btnMatchDoverennosti_Click"
                  screentip="Сопоставление доверенностей"
                  supertip="Поиск совпадений между доверенностями и операциями"/>

          <button id="btnLegacyBackfill"
                  label="Восстановить пакеты"
                  imageMso="DataRefreshAll"
                  size="large"
                  onAction="RibbonCallbacks.btnLegacyBackfill_Click"
                  screentip="Восстановление legacy-пакетов"
                  supertip="Построение и проверка предложений восстановления пакетов для старых строк IncOut"/>

          <button id="btnLegacyReview"
                  label="Проверка legacy"
                  imageMso="ReviewReviewingPane"
                  size="normal"
                  onAction="RibbonCallbacks.btnLegacyReview_Click"
                  screentip="Проверка legacy-совпадений"
                  supertip="Ручной разбор старых плоских строк, для которых найдено несколько вариантов проводок 1С"/>
        </group>
        
        <group id="grpAnalysis" label="Анализ и отчеты">
          <button id="btnStatistics" 
                  label="Статистика" 
                  imageMso="ChartInsert"
                  size="normal" 
                  onAction="RibbonCallbacks.btnStatistics_Click"
                  screentip="Статистика интеграции"
                  supertip="Отчет по результатам сопоставления с 1С"/>
          
          <button id="btnAnalyzeOperations" 
                  label="Анализ операций" 
                  imageMso="FindDialog"
                  size="normal" 
                  onAction="RibbonCallbacks.btnAnalyzeOperations_Click"
                  screentip="Анализ операций"
                  supertip="Подробный анализ операций и хода обработки"/>
          
          <button id="btnShowLog" 
                  label="Журнал" 
                  imageMso="ReviewReviewPane"
                  size="normal" 
                  onAction="RibbonCallbacks.btnShowLog_Click"
                  screentip="Журнал операций"
                  supertip="Просмотр журнала выполненных операций"/>
                  
          <separator id="sep3"/>
          
          <button id="btnGenerateWordLetters" 
                  label="Письма по доверенностям" 
                  imageMso="WordDocument"
                  size="large" 
                  onAction="RibbonCallbacks.btnGenerateWordLetters_Click"
                  screentip="Сформировать письма"
                  supertip="Создание Word-документов с письмами по несопоставленным доверенностям"/>
                  
        </group>
        
        <group id="grpManagement" label="Управление">
          <button id="btnSettings" 
                  label="Настройки" 
                  imageMso="ControlPanel"
                  size="normal" 
                  onAction="RibbonCallbacks.btnSettings_Click"
                  screentip="Настройки системы"
                  supertip="Настройка параметров системы"/>
          
          <button id="btnClearMarks" 
                  label="Очистить отметки" 
                  imageMso="Clear"
                  size="normal" 
                  onAction="RibbonCallbacks.btnClearMarks_Click"
                  screentip="Очистить отметки"
                  supertip="Очистка всех отметок исполнения"/>
          
          <separator id="sep2"/>
          
          <button id="btnBackupManager" 
                  label="Резервные копии" 
                  imageMso="DatabaseBackup"
                  size="normal" 
                  onAction="RibbonCallbacks.btnBackupManager_Click"
                  screentip="Резервные копии"
                  supertip="Управление резервными копиями"/>
          
          <button id="btnHelp" 
                  label="Справка" 
                  imageMso="Help"
                  size="normal" 
                  onAction="RibbonCallbacks.btnHelp_Click"
                  screentip="Справка"
                  supertip="Справка по использованию системы"/>
        </group>
        
      </tab>
    </tabs>
  </ribbon>
</customUI>
